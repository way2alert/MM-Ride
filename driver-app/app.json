{
  "expo": {
    "name": "MM Ride – Driver",
    "slug": "mm-ride-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0D14"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.mmride.driver",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0D14"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA",
        "SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow MM Ride to track your location during active duty shifts for navigation and safety.",
          "locationAlwaysPermission": "MM Ride requires background location access during your active shift to monitor route and safety.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MM Ride to take photos of documents and vehicle inspections."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MM Ride to upload document proofs and ride earnings screenshots."
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ]
  }
}
